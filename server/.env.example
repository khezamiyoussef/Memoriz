PORT=3000

# Same values as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY; used to verify the
# caller's Supabase session. Never put the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated origins allowed to call the API (default https://memoriz.club)
CORS_ORIGINS=https://memoriz.club,http://localhost:8080
# Set to the number of reverse proxies in front of the server, if any
# TRUST_PROXY=1
